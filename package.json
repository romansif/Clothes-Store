{
  "name": "cloth-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "node backend/src/server.js",
    "build": "vue-tsc -b && vite build",
    "install:all": "cd frontend && npm install && cd ../backend && npm install",
    "preview": "vite preview"
  },
  "dependencies": {
    "@intl-tel-input/vue": "^29.1.2",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.4",
    "vue": "^3.5.34",
    "vue3-google-signin": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
